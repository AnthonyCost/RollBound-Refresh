DATABASE_URL=postgres://postgres:postgres@localhost:5432/rollbound
PORT=3001

# Behind a load balancer or proxy: how many sit in front of the server (usually 1), so
# rate limits see each visitor's address. Leave unset when nothing is in front.
# TRUST_PROXY=1

# Local storage only: signs cover-image upload links. Any long random string; without it, links reset on restart.
UPLOAD_SECRET=change-me-to-a-long-random-string
# Where uploaded images are stored until S3 is set up (defaults to server/uploads).
# UPLOAD_DIR=./uploads

# --- Image storage -----------------------------------------------------------
# "local" saves uploaded images on this server (development). "s3" uses AWS S3.
# Setup guide: docs/aws-s3-setup.md
STORAGE_DRIVER=local

# Needed when STORAGE_DRIVER=s3:
# AWS_REGION=us-east-1
# S3_BUCKET=rollbound-refresh
# The bucket's address (no CloudFront), or a CloudFront domain:
# S3_PUBLIC_URL=https://rollbound-refresh.s3.us-east-1.amazonaws.com
#
# Credentials for local development only. In production, give the server an IAM
# role instead and leave these out. Never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Optional: an S3-compatible endpoint for testing without AWS (e.g. LocalStack).
# S3_ENDPOINT=http://localhost:4566

# Password reset emails (docs/password-reset-email-setup.md). Without a key, reset
# emails are printed to the server's terminal instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM="RollBound <no-reply@rollbound.com>"
# APP_URL=http://localhost:5173
