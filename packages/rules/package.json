{
  "name": "@rollbound/rules",
  "version": "0.1.0",
  "description": "Pure-function Pathfinder 2e (Remaster) rules engine for RollBound.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./load": "./src/load.js",
    "./data/*": "./data/*",
    "./bestiary/*": "./bestiary/*",
    "./armory/*": "./armory/*",
    "./glossary/*": "./glossary/*"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "data:aon": "node scripts/import-aon.js",
    "data:import": "node scripts/import-pf2e.js && echo \"Checking the new data with the build sweep...\" && node --test test/*.test.js",
    "data:bestiary": "node scripts/import-bestiary.js",
    "data:armory": "node scripts/import-armory.js",
    "data:glossary": "node scripts/import-glossary.js",
    "pregens": "node scripts/build-pregens.js"
  }
}
