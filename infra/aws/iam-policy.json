{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageCoverObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectTagging", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/covers/*"
    },
    {
      "Sid": "MissingCoversReturn404Not403",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME",
      "Condition": { "StringLike": { "s3:prefix": "covers/*" } }
    }
  ]
}
