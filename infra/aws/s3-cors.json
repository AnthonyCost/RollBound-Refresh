{
  "CORSRules": [
    {
      "ID": "browser-image-uploads",
      "AllowedOrigins": [
        "http://localhost:5173",
        "https://rollbound.com",
        "https://www.rollbound.com"
      ],
      "AllowedMethods": [
        "PUT",
        "GET"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "x-amz-tagging"
      ],
      "ExposeHeaders": [
        "ETag"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}
